DATABASE_URL=postgresql+asyncpg://tumaps:tumaps_dev@localhost/tumaps
# Production uses Neon: paste its direct (non-pooled) connection string as-is,
# e.g. postgresql://user:pass@ep-xxx.us-west-2.aws.neon.tech/neondb?sslmode=require
CORS_ORIGINS=["http://localhost:3000"]
# Optional: regex for extra allowed origins (defaults to the tu-maps Vercel domains)
# CORS_ORIGIN_REGEX=https://tu-maps(-[a-z0-9-]+)?\.vercel\.app

# Background incident refresh (hours between checks; 0 disables it locally)
INCIDENT_REFRESH_HOURS=0
# INCIDENT_MAX_AGE_DAYS=2
# INCIDENT_YEARS_BACK=3
